{
  "name": "portfolio-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run images && next dev --turbo",
    "serve": "bun run build && next start",
    "build": "bun run images && next build --turbo",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "analyze": "bunx unlighthouse --site https://bismitpanda.com --no-cache --enable-javascript --desktop --output-path .analytics",
    "analyze:mobile": "bunx unlighthouse --site https://bismitpanda.com --no-cache --enable-javascript --mobile --output-path .analytics",
    "images": "bun run scripts/build-project-images.tsx",
    "update:icons": "bun run scripts/update-icons.ts",
    "build:content": "bun run scripts/build-content.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vcard-creator": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@content-collections/core": "^0.15.3",
    "@content-collections/integrations": "^0.5.0",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "consola": "^3.4.2",
    "github-slugger": "^2.0.0",
    "mdx-bundler": "^10.1.1",
    "open-graph-scraper": "^6.11.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "msw",
    "sharp"
  ]
}
